BM25_K1=1.5
BM25_B=0.75
RAG_VECTOR_WEIGHT=0.6
RAG_BM25_WEIGHT=0.4
RAG_MAX_RETRIEVAL_ROUNDS=2
RERANK_MAX_CHARS=200
RAG_CHUNK_MAX_CHARS_FOR_LLM=500
MAX_CONCURRENT_REQUESTS=2
REQUEST_QUEUE_TIMEOUT_SECONDS=15
