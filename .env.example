MYSQL_CONNECT_TIMEOUT_SECONDS=5
MYSQL_READ_TIMEOUT_SECONDS=10
MYSQL_POOL_SIZE=4
MYSQL_POOL_ACQUIRE_TIMEOUT_SECONDS=5
MYSQL_FALLBACK_TO_SQLITE=true
ARTIFACT_DIR=data/artifacts
LOG_DIR=data/logs
EVAL_DATASET=evals/dataset.json
EVAL_OUTPUT=data/evaluation/report.json
REDIS_URL=
